<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      User-visible strings rendered by the AUI library. All keys use the `aui_` prefix
      so host apps can override them per-locale without colliding with their own
      resources. This file is English-only by design — translations belong in the host
      app's res/values-XX/ folders.
    -->

    <!-- Survey navigation buttons. -->
    <string name="aui_survey_back">Back</string>
    <string name="aui_survey_next">Next</string>
    <string name="aui_survey_submit">Submit</string>

    <!-- Survey submission summary text echoed in the user's outgoing message. -->
    <string name="aui_survey_skipped">Survey skipped</string>
    <string name="aui_survey_submitted">Survey submitted</string>
    <plurals name="aui_survey_questions_skipped_note">
        <item quantity="one">(%1$d question skipped)</item>
        <item quantity="other">(%1$d questions skipped)</item>
    </plurals>

    <!-- AuiResponseCard fallback labels and step-count description. -->
    <string name="aui_card_label_viewing">Viewing</string>
    <string name="aui_card_fallback_survey_title">Survey</string>
    <string name="aui_card_fallback_expanded_title">Tap to view</string>
    <plurals name="aui_card_step_count">
        <item quantity="one">%1$d question</item>
        <item quantity="other">%1$d questions</item>
    </plurals>

    <!-- AuiInputTextSingle default submit-button label. -->
    <string name="aui_input_text_submit_default">Submit</string>

    <!-- AuiInputRatingStars accessibility description for each star icon. -->
    <string name="aui_input_rating_star_content_description">Star %1$d</string>

    <!-- AuiInputRatingStars grouped TalkBack announcement (e.g. "Rated 3 of 5 stars"). -->
    <string name="aui_input_rating_announce_rated">Rated %1$d of %2$d stars</string>
    <string name="aui_input_rating_announce_unrated">Not rated, %1$d stars available</string>
    <!-- Custom action label for rate-N (e.g. "Rate 3 stars"). -->
    <plurals name="aui_input_rating_action_rate">
        <item quantity="one">Rate %1$d star</item>
        <item quantity="other">Rate %1$d stars</item>
    </plurals>

    <!-- AuiTable read-only rating-stars accessibility description (e.g. "4.5 of 5 stars"). -->
    <string name="aui_table_rating_stars_content_description">%1$s of %2$d stars</string>

    <!-- AuiBadge*/AuiStatusBanner* TalkBack prefixes that name the intent. -->
    <string name="aui_status_intent_success">Success</string>
    <string name="aui_status_intent_info">Information</string>
    <string name="aui_status_intent_warning">Warning</string>
    <string name="aui_status_intent_error">Error</string>
    <!-- "Success: 3 of 3 completed" — joins intent and message text. -->
    <string name="aui_status_announce">%1$s: %2$s</string>

    <!-- AuiChart TalkBack summary. Variants: bar / line / pie. -->
    <string name="aui_chart_variant_bar">Bar chart</string>
    <string name="aui_chart_variant_line">Line chart</string>
    <string name="aui_chart_variant_pie">Pie chart</string>
    <!-- "Bar chart: Quarterly revenue. Series: …" -->
    <string name="aui_chart_announce_titled">%1$s: %2$s. %3$s</string>
    <string name="aui_chart_announce_untitled">%1$s. %2$s</string>
    <string name="aui_chart_axis_labels">X axis %1$s, Y axis %2$s.</string>
    <string name="aui_chart_series_label">Series %1$s: %2$s</string>
    <string name="aui_chart_pie_slice">%1$s %2$s</string>
    <string name="aui_chart_point">%1$s %2$s</string>
    <string name="aui_chart_empty">No data</string>

    <!-- AuiStepperHorizontal TalkBack summary (e.g. "Step 2 of 3: Features. 1 step remaining"). -->
    <string name="aui_stepper_announce">Step %1$d of %2$d: %3$s. %4$s</string>
    <string name="aui_stepper_announce_complete">%1$d of %1$d steps complete: %2$s</string>
    <plurals name="aui_stepper_remaining">
        <item quantity="one">%1$d step remaining</item>
        <item quantity="other">%1$d steps remaining</item>
    </plurals>

    <!-- AuiFileContent action labels and download notices. -->
    <string name="aui_file_default_headline">File</string>
    <string name="aui_file_action_download">Download file</string>
    <string name="aui_file_action_copy">Copy file contents</string>
    <string name="aui_file_action_open">Open</string>
    <string name="aui_file_dismiss_notice">Dismiss download notice</string>
    <string name="aui_file_download_saved">Saved to Downloads: %1$s</string>
    <string name="aui_file_download_failed">Couldn\'t save to Downloads</string>

    <!-- AuiText fallback title for fenced code blocks with no language hint. -->
    <string name="aui_text_fenced_code_default_title">Text</string>
</resources>
